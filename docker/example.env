# sge_plus production environment variables
#
# Copy this file to /srv/sge_plus/.env on the server and fill in real values.
# chmod 600 /srv/sge_plus/.env
# NEVER commit the filled-in file to version control.

# ============================================================
# Rails core
# ============================================================
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true

# Generate with: docker run --rm IMAGE bundle exec rails secret
SECRET_KEY_BASE=REPLACE_WITH_RAILS_SECRET

RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
PORT=3000

# ============================================================
# Database (PostgreSQL — external, not in Docker)
# Required by dotenv at boot (config/initializers/dotenv.rb)
# ============================================================
DATABASE_URL=postgresql://sge_plus_user:REPLACE_PASSWORD@localhost:5432/sge_plus_production
DB_POOL=5

# ============================================================
# Solid Queue (ActiveJob backend, config/queue.yml)
# Number of worker processes started by `bin/jobs` in the worker
# container. Defaults to 1 if unset.
# ============================================================
JOB_CONCURRENCY=1

# ============================================================
# Redis (ActionCable in production)
# ============================================================
REDIS_URL=redis://localhost:6379/1

# ============================================================
# Memcached (Rails cache store — dalli gem)
# Required by dotenv at boot (config/initializers/dotenv.rb)
# ============================================================
MEMCACHE_URL=localhost:11211

# ============================================================
# Mailer (SMTP)
# ============================================================
SMTP_ADDRESS=smtp.example.com
SMTP_DOMAIN=example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD

# ============================================================
# Decidim application settings
# ============================================================
DECIDIM_APPLICATION_NAME=SGE+
DECIDIM_MAILER_SENDER=noreply@example.cat
DECIDIM_DEFAULT_LOCALE=ca
DECIDIM_AVAILABLE_LOCALES=ca,es
DECIDIM_FORCE_SSL=false

# ============================================================
# Signador AOC — decidim-signature_collection module
# ============================================================
SIGNADOR_DOMAIN=https://your-app-domain.cat
SIGNADOR_BASE_URL=https://signador.aoc.cat
SIGNADOR_API_KEY=REPLACE_SIGNADOR_API_KEY
SIGNADOR_CALLBACK_PATH=/valid_signador/callback

# ============================================================
# Active Storage
# Options: local, s3, gcs
# "local" writes to the bind-mounted storage/ volume.
# On AWS Fargate use "s3": the container disk is ephemeral.
# ============================================================
STORAGE_PROVIDER=s3

# S3 (if STORAGE_PROVIDER=s3)
# Private bucket: files are served through the app (Rails proxy).
# Set these in both the web and the worker containers.
# AWS_REGION=eu-west-1
# AWS_BUCKET=sge-plus-production
#
# Credentials: on Fargate leave the access keys unset; the SDK uses the ECS
# task IAM role (taskRoleArn). Set them only outside AWS (e.g. local Docker).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Optional: "true" uploads files with a public-read ACL (default: false).
# AWS_PUBLIC=false
# Optional: S3-compatible endpoint (e.g. MinIO).
# AWS_ENDPOINT=
