<% add_decidim_page_title(t("decidim.admin.titles.candidacies")) %>
<div class="card" id="candidacies">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t("decidim.admin.titles.candidacies") %>

      <% if allowed_to? :export, :candidacies %>
        <%= export_dropdowns(query) %>
      <% end %>
    </h1>
  </div>
  <%= admin_filter_selector(:candidacies) %>

  <% if show_candidacy_type_callout? %>
    <% link = link_to(t("button", scope:"decidim.signature_collection.admin.index.candidacies_types"), new_candidacies_type_path, class: "button button__sm button__secondary mt-4") %>
    <%= cell("decidim/announcement", t("alert_html", scope:"decidim.signature_collection.admin.index.candidacies_types", link:), callout_class: "alert") %>
  <% else %>
    <div class="table-scroll">
      <table class="table-list">
        <thead>
        <tr>
          <th><%= t("models.candidacies.fields.id", scope: "decidim.admin") %></th>
          <th class="!text-left"><%= t("models.candidacies.fields.title", scope: "decidim.admin") %></th>
          <th><%= t("models.candidacies.fields.state", scope: "decidim.admin") %></th>
          <th><%= sort_link(query, :supports_count, t("models.candidacies.fields.supports_count", scope: "decidim.admin"), default_order: :desc) %></th>
          <th><%= sort_link(query, :created_at, t("models.candidacies.fields.created_at", scope: "decidim.admin"), default_order: :desc) %></th>
          <th><%= sort_link(query, :published_at, t("models.candidacies.fields.published_at", scope: "decidim.admin"), default_order: :desc) %></th>
          <th><%= t ".actions_title" %></th>
        </tr>
        </thead>
        <tbody>
        <% @candidacies.each do |candidacy| %>
          <tr>
            <td data-label="<%= t("models.candidacies.fields.id", scope: "decidim.admin") %>"><%= candidacy.id %></td>
            <td class="!text-left" data-label="<%= t("models.candidacies.fields.title", scope: "decidim.admin") %>">
              <% if allowed_to? :edit, :candidacy, candidacy: candidacy %>
                <%= link_to translated_attribute(candidacy.title),
                            decidim_admin_candidacies.edit_candidacy_path(candidacy.to_param) %>
              <% else %>
                <%= translated_attribute(candidacy.title) %>
              <% end %>
            </td>
            <td data-label="<%= t("models.candidacies.fields.state", scope: "decidim.admin") %>"><%= humanize_admin_state candidacy.state %></td>
            <td data-label="<%= t("models.candidacies.fields.supports_count", scope: "decidim.admin") %>"><%= candidacy.supports_count %>/<%= candidacy.scoped_type.supports_required %></td>
            <td class="table-list__date"><%= l candidacy.created_at, format: :short %></td>
            <td class="table-list__date"><%= candidacy.published_at? ? l(candidacy.published_at, format: :short) : "" %></td>
            <td class="table-list__actions">
              <button type="button" data-controller="dropdown" data-target="actions-candidacy-<%= candidacy.id %>" aria-label="<%= t("decidim.admin.actions.actions_label", resource: translated_attribute(candidacy.title)) %>">
                <%= icon "more-fill", class: "text-secondary" %>
              </button>

              <div class="inline-block relative">
                <ul id="actions-candidacy-<%= candidacy.id %>" class="dropdown dropdown__action" aria-hidden="true">
                  <% if allowed_to? :edit, :candidacy, candidacy: candidacy %>
                    <li class="dropdown__item">
                      <%= link_to decidim_admin_candidacies.edit_candidacy_path(candidacy.to_param), class: "dropdown__button" do %>
                        <%= icon "pencil-line" %>
                        <%= t("actions.edit", scope: "decidim.admin") %>
                      <% end %>
                    </li>
                  <% end %>

                  <hr>

                  <% if allowed_to?(:answer, :candidacy, candidacy: candidacy) %>
                    <li class="dropdown__item">
                      <%= link_to edit_candidacy_answer_path(candidacy.slug), class: "dropdown__button" do %>
                        <%= icon "chat-1-line" %>
                        <%= t("actions.answer", scope: "decidim.candidacies") %>
                      <% end %>
                    </li>
                  <% else %>
                    <li class="dropdown__item">
                      <div class="dropdown__button-disabled">
                        <%= with_tooltip(t("actions.cannot_answer", scope: "decidim.admin"), class: :left) do %>
                          <%= icon "chat-1-line", class: "text-gray" %>
                          <span><%= t("actions.answer", scope: "decidim.candidacies") %></span>
                        <% end %>
                      </div>
                    </li>
                  <% end %>

                  <% if allowed_to? :print, :candidacy, candidacy: candidacy %>
                    <li class="dropdown__item">
                      <%= link_to decidim_candidacies.print_candidacy_path(candidacy), class: "dropdown__button", target: "_blank", data: { "external-link": false } do %>
                        <%= icon "printer-line" %>
                        <%= t(".print") %>
                      <% end %>
                    </li>
                  <% end %>

                  <hr>

                  <% if allowed_to? :preview, :candidacy, candidacy: candidacy %>
                    <li class="dropdown__item">
                      <%= link_to decidim_candidacies.candidacy_path(candidacy.to_param), class: "dropdown__button", target: "_blank", data: { "external-link": false } do %>
                        <%= icon "eye-line" %>
                        <%= t(".preview") %>
                      <% end %>
                    </li>
                  <% end %>

                  <% if allowed_to? :read, :share_token, current_participatory_space: candidacy %>
                    <li class="dropdown__item">
                      <%= link_to decidim_admin_candidacies.candidacy_share_tokens_path(candidacy), class: "dropdown__button" do %>
                        <%= icon "share-line" %>
                        <%= t("actions.share_tokens", scope: "decidim.admin") %>
                      <% end %>
                    </li>

                    <hr>
                  <% end %>

                  <% if (link = free_resource_permissions_link(candidacy)) %>
                    <li class="dropdown__item">
                      <%= link %>
                    </li>
                  <% end %>
                </ul>
              </div>

            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
<%= decidim_paginate @candidacies %>
